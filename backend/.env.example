# Server Port
PORT=4000

# PostgreSQL Database Connection URL (Prisma)
DATABASE_URL="postgresql://scheduler:scheduler@localhost:5432/scheduler?schema=public"

# Redis Configuration (BullMQ & Rate Limiting)
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""

# Worker Configuration
WORKER_CONCURRENCY=5
MIN_SEND_DELAY_MS=1000

# Rate Limiting
MAX_EMAILS_PER_HOUR_PER_SENDER=10

# Optional Ethereal Email Credentials (if omitted, auto-generates test account on boot)
ETHEREAL_USER=""
ETHEREAL_PASS=""

